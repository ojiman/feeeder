+    // Synthetic spike: preserve a character on the top line without reinstalling the article.
+    func updateReadingSize(_ size: CGFloat) {
+        guard let manager = layoutManager, let container = textContainer, let storage = textStorage,
+              let scroll = enclosingScrollView else { return }
+        manager.ensureLayout(for: container)
+        let point = NSPoint(x: 0, y: max(0, scroll.contentView.bounds.minY - textContainerOrigin.y))
+        let glyph = manager.glyphIndex(for: point, in: container)
+        let character = manager.characterIndexForGlyph(at: glyph)
+        let oldLine = manager.lineFragmentRect(forGlyphAt: glyph, effectiveRange: nil)
+        let withinLine = point.y - oldLine.minY
+        let selection = selectedRanges
+        installing = true
+        defer { installing = false }
+        storage.beginEditing()
+        for paragraph in paragraphRanges {
+            let range = NSRange(location: paragraph.location, length: paragraph.length + 1)
+            storage.addAttribute(.font, value: NSFont.systemFont(ofSize: size), range: range)
+            let style = (storage.attribute(.paragraphStyle, at: range.location, effectiveRange: nil) as? NSParagraphStyle)?.mutableCopy() as? NSMutableParagraphStyle ?? NSMutableParagraphStyle()
+            style.lineSpacing = size / 2
+            storage.addAttribute(.paragraphStyle, value: style, range: range)
+        }
+        storage.endEditing()
+        maximumBodyWidth = 670 * size / 16
+        let width = max(1, min(maximumBodyWidth, frame.width - 84))
+        container.containerSize.width = width
+        textContainerInset.width = max(42, (frame.width - width) / 2)
+        paragraphYs = []
+        layoutDocument()
+        let newGlyph = manager.glyphIndexForCharacter(at: character)
+        let newLine = manager.lineFragmentRect(forGlyphAt: newGlyph, effectiveRange: nil)
+        let target = max(0, min(frame.height - scroll.contentSize.height, newLine.minY + textContainerOrigin.y + max(0, min(withinLine, newLine.height - 1))))
+        scroll.contentView.scroll(to: NSPoint(x: 0, y: target))
+        scroll.reflectScrolledClipView(scroll.contentView)
+        selectedRanges = selection
+        needsDisplay = true
+    }
